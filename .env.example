# DATABASE_URL: Neon PostgreSQL connection URL.
# We fall back to the provided connection string in the code if this is not specified.
DATABASE_URL=""

# -----------------------------------------------------------------------------
# NextAuth / Auth.js Configuration
# -----------------------------------------------------------------------------

# AUTH_SECRET: Used to encrypt the NextAuth session token.
# Generate a random string using `openssl rand -base64 32` or similar.
AUTH_SECRET="your_random_secret_here"

# Neon Auth URL (from Neon Console)
VITE_NEON_AUTH_URL=""

# Neon Data API URL
VITE_NEON_DATA_API_URL=""

# Teacher Registration PIN (6-digit code)
VITE_TEACHER_PIN="123456"
